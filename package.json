{
  "name": "pretrust",
  "version": "0.1.0",
  "description": "Maps every code-execution path that fires when you open or clone a repo — before you run anything. Deterministic, offline, editor- and agent-agnostic.",
  "type": "module",
  "bin": {
    "pretrust": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "security",
    "supply-chain",
    "malware",
    "static-analysis",
    "vscode",
    "devcontainer",
    "git-hooks",
    "direnv",
    "claude-code",
    "cursor",
    "mcp",
    "sarif",
    "cli",
    "workspace-trust",
    "code-execution"
  ],
  "author": "hamodywe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamodywe/pretrust.git"
  },
  "bugs": {
    "url": "https://github.com/hamodywe/pretrust/issues"
  },
  "homepage": "https://github.com/hamodywe/pretrust#readme"
}
